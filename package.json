{
  "name": "wattbuch-neu",
  "productName": "Wattbuch Neu",
  "version": "0.1.0",
  "description": "Rollentraining als Runde in einer 3D-Welt (Mac-App)",
  "main": "app/main.cjs",
  "private": true,
  "author": "Lukas Rückborn",
  "scripts": {
    "bau": "vite build",
    "check": "node scripts/check.mjs && tsc --noEmit",
    "logik": "vitest run",
    "test": "npm run check && vitest run && vite build && playwright test",
    "app": "vite build && electron .",
    "app:sim": "vite build && WATTBUCH_SIM=1 WATTBUCH_DATA=.sim electron .",
    "app:build": "vite build && electron-builder --mac --arm64 --dir",
    "app:install": "node scripts/install-app.mjs",
    "entwurf": "node scripts/serve.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "de.rueckborn.wattbuch.neu",
    "productName": "Wattbuch Neu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "bau/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "identity": null,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Wattbuch verbindet sich per Bluetooth mit Rollentrainer, Pulsgurt und Trittfrequenzsensor."
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/three": "^0.170.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "type": "module"
}
