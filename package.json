{
  "name": "wattbuch",
  "productName": "Wattbuch",
  "version": "1.0.2",
  "description": "Watt aufnehmen und auswerten, Strecken mit echter Steigung (Mac und Windows)",
  "main": "desktop/main.js",
  "private": true,
  "author": "Lukas Rückborn",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/manifest.mjs && node scripts/check.mjs",
    "test": "node scripts/manifest.mjs && node scripts/check.mjs && playwright test",
    "app": "electron .",
    "app:build": "electron-builder --mac --arm64 --dir",
    "app:install": "node scripts/install-app.mjs",
    "app:release": "node scripts/release-app.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "icon": "electron scripts/make-icon.js",
    "manifest": "node scripts/manifest.mjs"
  },
  "build": {
    "appId": "de.rueckborn.wattbuch",
    "productName": "Wattbuch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.css",
      "js/**/*",
      "desktop/**/*",
      "package.json",
      "manifest.json"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "desktop/icon.png",
      "identity": null,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Wattbuch verbindet sich per Bluetooth mit Rollentrainer, Pulsgurt und Trittfrequenzsensor.",
        "NSLocalNetworkUsageDescription": "Wattbuch sucht dein Apple TV im WLAN, um es während der Fahrt zu steuern.",
        "NSBonjourServices": [
          "_airplay._tcp",
          "_companion-link._tcp",
          "_mediaremotetv._tcp",
          "_raop._tcp",
          "_appletv-v2._tcp",
          "_touch-able._tcp",
          "_device-info._tcp",
          "_sleep-proxy._udp"
        ]
      }
    },
    "win": {
      "icon": "desktop/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Wattbuch-Setup-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Wattbuch",
      "uninstallDisplayName": "Wattbuch"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
